# Access control
ALLOWED_EMAIL=owner@example.com
# Optional bearer token for non-Sites administrative calls.
ADMIN_TOKEN=

# Optional per-environment override for the public support inbox shown on
# /support. The site already defaults to support@signalledgerlab.com (see
# lib/site-config.ts); set this only to point a specific environment elsewhere.
SUPPORT_EMAIL=

# SEC asks automated clients to identify a contact.
SEC_USER_AGENT=Market Signal Lab owner@example.com

# Commercial news and market-data source. PICK-NY reads adjusted daily bars from
# Alpaca, so the model portfolio needs these credentials to compute anything.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Feed for adjusted daily bars: "iex" (default, available on free plans) or
# "sip" when the plan allows it. The active feed is labelled on the panel.
ALPACA_DATA_FEED=iex

# Optional site-local fallback only. The always-on Worker uses the protected
# Gmail webhook. Resend requires a verified sender domain.
RESEND_API_KEY=
ALERT_FROM=Signal Ledger <alerts@your-verified-domain.example>
ALERT_RECIPIENT=owner@example.com

# Optional always-on monitor Worker. Sites reads from it first and falls back
# to its own D1/manual collector when it is unavailable.
MONITOR_API_URL=
MONITOR_READ_TOKEN=
CRON_SECRET=

# The Worker that drains the service email queue (auth links). Defaults to
# MONITOR_API_URL; point Preview at the sandbox Worker, never production.
SERVICE_EMAIL_WORKER_URL=
# Shared secret for the server-to-server "flush now" nudge after Pages queues an
# auth email. Must be identical on Pages and the Worker; distinct from CRON_SECRET.
SERVICE_EMAIL_FLUSH_TOKEN=

# Optional server-side AI valuation orchestrator. Keep the API key in the
# Cloudflare Worker secret store; never expose it in browser JavaScript.
OPENAI_API_KEY=
AI_VALUATION_ENABLED=false
OPENAI_VALUATION_MODEL=gpt-5.6-luna
OPENAI_REVIEW_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low

# Stripe billing. The explicit payments gate is authoritative: live payments run
# ONLY when STRIPE_PAYMENTS_MODE=live, and only with an sk_live_ key AND live
# price ids. Any other value (or missing) is safe test mode, which refuses live
# keys — so a misconfigured deploy fails closed instead of charging real cards.
# STRIPE_SECRET_KEY is server-only and must never reach the client bundle.
# STRIPE_WEBHOOK_SECRET is only read by the monitor Worker's /webhooks/stripe.
STRIPE_PAYMENTS_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Two recurring USD prices under the single "Signal Ledger Pro" product. Price
# ids are not secrets, but they are server-side so a client cannot submit one.
STRIPE_PRICE_PRO_MONTHLY_USD=
STRIPE_PRICE_PRO_ANNUAL_USD=

# Retired — Paddle was abandoned (Paddle does not support this business
# category). Left for reference only; the active billing path is Stripe.
# PADDLE_API_KEY=
# PADDLE_CLIENT_SIDE_TOKEN=
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_PRICE_PRO_MONTHLY_USD=
# PADDLE_PRICE_PRO_MONTHLY_CNY=
# PADDLE_PRICE_PRO_ANNUAL_USD=
# PADDLE_PRICE_PRO_ANNUAL_CNY=
# PADDLE_PRICE_PRO_ONETIME_CNY=

# Whop — sandbox only in this release. Same IDs/version on Pages and Worker.
# Store secrets through Cloudflare secret storage, never in NEXT_PUBLIC_* vars.
# Keep checkout off until sandbox DB migration and webhook configuration pass.
WHOP_ENVIRONMENT=sandbox
WHOP_CHECKOUT_ENABLED=false
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_ACCOUNT_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_MONTHLY_ID=
WHOP_PLAN_ANNUAL_ID=
# SITE_ORIGIN must be an isolated preview origin, never the production domain.
